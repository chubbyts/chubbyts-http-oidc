{
  "name": "@chubbyts/chubbyts-http-oidc",
  "type": "module",
  "version": "1.1.1",
  "description": "A minimal OIDC (OpenID Connect) resource server integration for @chubbyts/chubbyts-http-types.",
  "keywords": [
    "oidc",
    "openid-connect",
    "jwt",
    "jwks",
    "bearer",
    "middleware",
    "chubbyts",
    "http"
  ],
  "author": "Dominik Zogg",
  "license": "MIT",
  "repository": "chubbyts/chubbyts-http-oidc",
  "scripts": {
    "build": "rm -Rf dist && tsc",
    "cs-fix": "prettier --write src tests resources",
    "cs": "prettier --check src tests resources",
    "infection": "stryker run",
    "lint-fix": "oxlint --fix src tests resources vitest.config.ts vitest.integration.config.ts",
    "lint": "oxlint src tests resources vitest.config.ts vitest.integration.config.ts",
    "prepare": "pnpm run build",
    "test:integration": "vitest --config vitest.integration.config.ts",
    "test": "vitest"
  },
  "prettier": {
    "printWidth": 120,
    "tabWidth": 2,
    "singleQuote": true,
    "trailingComma": "all"
  },
  "files": [
    "dist"
  ],
  "exports": {
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js",
      "default": "./dist/*.js"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@chubbyts/chubbyts-dic-config-factory": "^1.1.1",
    "@chubbyts/chubbyts-dic-types": "^2.4.1",
    "@chubbyts/chubbyts-http-types": "^4.3.1",
    "@chubbyts/chubbyts-log-types": "^3.4.2",
    "jose": "^6.2.18"
  },
  "devDependencies": {
    "@chubbyts/chubbyts-dic-config": "^2.4.1",
    "@chubbyts/chubbyts-function-mock": "^2.4.1",
    "@chubbyts/chubbyts-http": "^3.2.1",
    "@chubbyts/chubbyts-oxlint": "^1.0.3",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.1",
    "oxlint": "^1.95.0",
    "prettier": "^3.10.1",
    "testcontainers": "^12.2.2",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@12.23.0+sha512.02da94ffaf133f46074322afe552f90d40b5f71ae259aefbccdacc5085b1d617e98d65e0131f5748b9b67445978ee5055d7d59a473f1eef0d504854fefcd5975"
}
